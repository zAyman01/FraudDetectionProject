# Python cache and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE settings
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Project outputs
results/figures/*
results/metrics/*
!results/figures/.gitkeep
!results/metrics/.gitkeep

# Large data (do not commit local datasets)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

